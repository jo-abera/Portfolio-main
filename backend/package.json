{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express REST API + admin authorization layer for the portfolio. Prisma → PostgreSQL; Supabase → auth & storage.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "storage:ensure": "node scripts/ensureStorageBuckets.js",
    "db:social-platforms": "node scripts/applySocialPlatformsMigration.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  }
}
